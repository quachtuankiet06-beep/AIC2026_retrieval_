# =============================================================
# .env.example - Biến môi trường mẫu cho Docker
# Sao chép file này thành .env và điền giá trị thực
# =============================================================

# Cổng chạy FastAPI (mặc định: 8000)
PORT=8000

# Đường dẫn thư mục video trên HOST (máy thật)
# Windows example: VIDEO_HOST_DIR=C:/Users/Public/Documents
# Linux example:   VIDEO_HOST_DIR=/mnt/videos
VIDEO_HOST_DIR=C:/Users/Public/Documents

# Huggingface token (nếu cần tải model private, để trống nếu không cần)
HF_TOKEN=

# Môi trường chạy: production hoặc development
ENV=production
